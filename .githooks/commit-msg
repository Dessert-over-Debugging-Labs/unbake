#!/bin/sh
# Commit message convention check (see AGENTS.md)
# Format: <type>(<scope>): <subject>  or  <type>: <subject>

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Auto-generated merge/revert messages pass through
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types="feat|fix|docs|refactor|test|chore|build|ci|perf|revert"

if ! printf '%s' "$subject" | grep -Eq "^($types)(\([a-z0-9-]+\))?: .+"; then
  echo "✖ Commit message does not match the convention (see AGENTS.md)" >&2
  echo "  format: <type>(<scope>): <subject>   (scope optional)" >&2
  echo "  types: feat fix docs refactor test chore build ci perf revert" >&2
  echo "  got:   $subject" >&2
  exit 1
fi

if printf '%s' "$subject" | grep -Eq '\.$'; then
  echo "✖ Do not end the subject with a period: $subject" >&2
  exit 1
fi

# English by default -- warn (do not block) on Hangul in the subject
if printf '%s' "$subject" | grep -q '[가-힣]'; then
  echo "⚠ Commit subjects are English by default (see AGENTS.md)." >&2
fi

# ~50 chars recommended -- warn above 72 (commit still proceeds)
len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$len" -gt 72 ]; then
  echo "⚠ Subject is ${len} chars; ~50 is recommended." >&2
fi

exit 0
