# ── LLM ──────────────────────────────────────────────
# Gemini API key (extraction A/B, description parsing, judging/matching) — required
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Per-role model overrides (optional — defaults live in src/unbake/config.py
# DEFAULT_MODELS). Exact model IDs only; no `latest` aliases.
# GEMINI_MODEL_GENERATOR=gemini-3.1-pro-preview
# GEMINI_MODEL_BLIND=gemini-3.1-pro-preview
# GEMINI_MODEL_DESCRIPTION=gemini-3.7-flash
# GEMINI_MODEL_JUDGE=gemini-3.7-flash
# GEMINI_MODEL_MATCHER=gemini-3.7-flash

# ── Video metadata ───────────────────────────────────
# YouTube Data API v3 key — used to fetch title/description/duration for a URL.
# Optional: skip it if you pass description and duration_ms yourself.
YOUTUBE_API_KEY=

# ── Domain gate (optional — cheap text-only "is this a cooking video?" check
#    that runs before any video is sent to a model) ──
# OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# openrouter (default when the key above is set) | gemini (reuse GEMINI_API_KEY) | off
# DOMAIN_CHECK=openrouter
# Exact model ID for the gate — an OpenRouter ID, or a Gemini ID when DOMAIN_CHECK=gemini
# DOMAIN_MODEL=openai/gpt-5.4-nano

# ── Output ───────────────────────────────────────────
# Where artifacts go (default: ./output relative to the working directory)
# UNBAKE_OUTPUT_DIR=./output
